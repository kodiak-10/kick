{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Keypoints2D",
  "type": "object",
  "required": ["clip_id", "fps", "keypoint_names", "frames", "detector", "model_version", "generated_at", "frame_count"],
  "properties": {
    "clip_id": {"type": "string"},
    "fps": {"type": "number"},
    "keypoint_names": {"type": "array", "items": {"type": "string"}},
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp_ms", "keypoints", "mean_confidence"],
        "properties": {
          "timestamp_ms": {"type": "integer"},
          "keypoints": {"type": "array", "items": {"type": "number"}},
          "mean_confidence": {"type": "number"}
        }
      }
    },
    "detector": {"type": "string"},
    "model_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "frame_count": {"type": "integer"}
  }
}
